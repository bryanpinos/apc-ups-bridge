#pragma once
// Copy to secrets.h and fill in. secrets.h is gitignored.

#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-wifi-password"
#define OTA_PASSWORD  "choose-an-ota-password"

#define MQTT_HOST     "192.168.0.10"   // your MQTT broker
#define MQTT_PORT     1883

// ---- per-unit identity ----
// UNIT_HOST must be RFC-1123 legal: letters, digits, hyphens. No underscores.
// Home Assistant derives entity_ids from UNIT_NAME, so choose it deliberately.
#define UNIT_ID       "ups_bridge"
#define UNIT_HOST     "ups-bridge"
#define UNIT_NAME     "UPS Bridge"

#define OTA_HOST      "192.168.0.50"   // this board's IP, for OTA uploads
