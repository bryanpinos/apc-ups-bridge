.pio/
# Per-unit secrets (secrets.office.h, secrets.aquarium.h, ...). Broad glob on
# purpose: a later unit's file must be ignored by default, never by remembering
# to add it. The .example template is the one exception and stays tracked.
src/secrets*
!src/secrets.h.example

# generated by ota-flash, contains the OTA password
src/ota_secret.h
